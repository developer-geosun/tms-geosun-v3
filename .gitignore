# Залежності та збірка (Angular після ініціалізації)
node_modules/
dist/
.angular/
.env
backend-java/.env
frontend-angular/.env
frontend-angular/src/assets/app-config.local.js

# Локальні завантаження файлів (app.storage.type=local)
data/uploads/
backend-java/data/uploads/
backend-java/target/test-uploads/

# Локальна конфігурація clasp (скопіюйте з .clasp.json.example і додайте scriptId)
backend-java/.clasp.json

# IDE / ОС (лише корінь репо; frontend-angular/.vscode залишається з шаблону Angular)
.idea/
# У корені .vscode ігноруємо все, крім зафіксованих налаштувань Java для Cursor/VS Code
/.vscode/*
!/.vscode/settings.json
!/.vscode/extensions.json
*.log
.DS_Store
Thumbs.db
